# Build-контейнер VLANit PBX OS.
# Сборка полностью происходит внутри привилегированного контейнера Debian 13,
# чтобы не требовать root на сборочной машине.
FROM debian:13

RUN apt-get update && apt-get install -y --no-install-recommends \
        mmdebstrap \
        xorriso \
        squashfs-tools \
        grub-efi-amd64-bin \
        grub-pc-bin \
        grub-common \
        python3-cairosvg \
        python3-pil \
        fonts-dejavu-core \
        mtools \
        zstd \
        cpio \
        curl \
        ca-certificates \
        python3 \
        jq \
        xz-utils \
        gpg \
        debian-archive-keyring \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
ENV DEBIAN_FRONTEND=noninteractive
CMD ["bash", "scripts/build.sh"]
