# VLANit PBX OS — systemd Quadlet для MikoPBX (rootful Podman)
# Помещается установщиком/сборкой в /etc/containers/systemd/mikopbx.container
[Unit]
Description=MikoPBX (VLANit PBX OS)
Documentation=https://docs.mikopbx.com
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/vlanit/mikopbx:2026.6.99-amd64
ContainerName=mikopbx
HostName=mikopbx
Network=host
AddCapability=NET_ADMIN
Volume=/var/spool/mikopbx/cf:/cf
Volume=/var/spool/mikopbx/storage:/storage
Environment=ID_WWW_USER=1001
Environment=ID_WWW_GROUP=1001
Environment=SSH_PORT=23

PidsLimit=4096
# лимит времени на остановку контейнера (SIGTERM -> SIGKILL): MikoPBX
# корректно завершает звонки/записи дольше 10 с дефолта (полевой дефект 1.2.4)
StopTimeout=120

[Service]
Restart=always
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
