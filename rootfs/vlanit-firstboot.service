[Unit]
Description=VLANit first boot provisioning
ConditionPathExists=!/var/lib/vlanit/firstboot-done
# после multi-user: избегаем циклов транзакции systemd при старте служб
After=multi-user.target
Wants=multi-user.target

[Service]
Type=oneshot
ExecStart=/opt/vlanit/vlanit-firstboot.sh
RemainAfterExit=true
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
